&hdmi_sound {
	status = "okay";
};

dsi_i2c: &i2c1 {
	/* connect to dsi touch */
	status = "okay";
	clock-frequency = <400000>;
	#address-cells = <1>;
	#size-cells = <0>;

	dsi0_gt911: dsi0-gt911@14 {
        compatible = "goodix,gt911";
        reg = <0x14>;
        AVDD28-supply = <&vdd3v3>;
        VDDIO-supply = <&vdd3v3>;
        pinctrl-names = "default";
        pinctrl-0 = <&touch_gpio>;
        interrupts = <RK_PA2 IRQ_TYPE_EDGE_FALLING>;
        interrupt-parent = <&gpio3>;
        irq-gpios = <&gpio3 RK_PA2 GPIO_ACTIVE_HIGH>;
        reset-gpios = <&gpio3 RK_PA0 GPIO_ACTIVE_HIGH>;
        touchscreen-size-x = <1200>;
        touchscreen-size-y = <1920>;
        // touchscreen-inverted-x;
        // touchscreen-inverted-y;
        // touchscreen-swapped-x-y;
    };
};

&i2c5 {
    status = "okay";

	hym8563: hym8563@51 {
		compatible = "haoyu,hym8563";
		reg = <0x51>;
		#clock-cells = <0>;
		clock-frequency = <32768>;
		clock-output-names = "hym8563";
	};
};

&i2s0_8ch {
    status = "okay";
};

&i2s3_2ch {
	status = "okay";
};

&mdio0 {
    rgmii_phy0: phy@0 {
        compatible = "ethernet-phy-ieee802.3-c22";
        reg = <0x0>;
        clocks = <&cru CLK_MAC0_OUT>;
		interrupt-parent = <&gpio2>;
		interrupts = <RK_PD2 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-names = "default";
    	pinctrl-0 = <&eth_phy0_int>;
    };
};

&mdio1 {
    rgmii_phy1: phy@0 {
        compatible = "ethernet-phy-ieee802.3-c22";
        reg = <0x0>;
        clocks = <&cru CLK_MAC1_OUT>;
		interrupt-parent = <&gpio2>;
		interrupts = <RK_PD0 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-names = "default";
    	pinctrl-0 = <&eth_phy1_int>;
    };
};

&pcie30phy {
    status = "okay";
};

&pcie3x1 {
    rockchip,bifurcation;
	vpcie3v3-supply = <&vdd_4g>;
	status = "okay";
};

&pcie3x2 {
    rockchip,bifurcation;
	num-lanes = <1>;
	reset-gpios = <&gpio2 RK_PD6 GPIO_ACTIVE_HIGH>;
    vpcie3v3-supply = <&vcc3v3_m2>;
	pinctrl-0 = <&pcie30x2m1_pins>; 
	status = "okay";
};

&pinctrl {
	audio {
		spk_en_pin: spk-en-pin {
			rockchip,pins = <1 RK_PB1 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		spk_mute_pin: spk-mute-pin {
			rockchip,pins = <1 RK_PB2 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	eth-phy {
		eth_phy0_int: eth-phy0-int {
			rockchip,pins = <2 RK_PD2 RK_FUNC_GPIO &pcfg_pull_up>;
		};

		eth_phy1_int: eth-phy1-int {
			rockchip,pins = <2 RK_PD0 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

	gpio-fans {
		/omit-if-no-ref/
		sys_fan_pin: sys-fan-pin {
			rockchip,pins = <3 RK_PB6 RK_FUNC_GPIO &pcfg_pull_down>;
		};
	};

	gpio-leds {
		sys_led_pin: sys-led-pin {
			rockchip,pins = <0 RK_PD6 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	headphone {
        hp_det: hp-det {
            rockchip,pins = <1 RK_PB0 RK_FUNC_GPIO &pcfg_pull_down>;
        };
    };

	hub {
		hub_rst_pin: hub-rst-pin {
			rockchip,pins = <2 RK_PD7 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	lcd {
		/omit-if-no-ref/
		lcd_rst: lcd-rst {
			rockchip,pins = <4 RK_PD2 RK_FUNC_GPIO &pcfg_pull_up>;
		};
		
		/omit-if-no-ref/
		lcd_pwren: lcd-pwren {
			rockchip,pins = <0 RK_PC7 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	pcie {
		minipcie_pwren: minipcie-pwren {
			rockchip,pins = <3 RK_PB5 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		m2_pwren: m2-pwren {
			rockchip,pins = <3 RK_PA7 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		pcie_clk_en: pcie-clk-en {
			rockchip,pins = <0 RK_PD3 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

	touch {
		/omit-if-no-ref/
		touch_gpio: touch-gpio {
			rockchip,pins = 
				<3 RK_PA0 RK_FUNC_GPIO &pcfg_pull_none>,
				<3 RK_PA2 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	usb {
		usbotg_pwren: usbotg-pwren {
			rockchip,pins = <0 RK_PA5 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		usbhost_pwren: usbhost-pwren {
			rockchip,pins = <0 RK_PA6 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		usbotg_en: usbotg-en {
			rockchip,pins = <1 RK_PA4 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

	wireless-bluetooth {
		uart8_gpios: uart8-gpios {
			rockchip,pins = <2 RK_PB1 RK_FUNC_GPIO &pcfg_pull_none>;
		};
		
		bt_gpio: bt-gpio {
			rockchip,pins =
				<4 RK_PC4 RK_FUNC_GPIO &pcfg_pull_none>,
				<0 RK_PD4 RK_FUNC_GPIO &pcfg_pull_none>,
				<0 RK_PD5 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
	
	wireless-wlan {
		wifi_host_wake_irq: wifi-host-wake-irq {
			rockchip,pins = <3 RK_PD4 RK_FUNC_GPIO &pcfg_pull_down>;
		};
		
		wifi_poweren_gpio: wifi-poweren-gpio {
			rockchip,pins = <3 RK_PD5 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};
};

dsi0_pwm: &pwm4 {
	status = "okay";
};

dsi1_pwm: &pwm5 {
	status = "disabled";
};

&route_dsi0 {
	status = "okay";
	connect = <&vp1_out_dsi0>;
};

// &route_hdmi {
// 	status = "okay";
// 	connect = <&vp0_out_hdmi>;
// };

&sata2 {
	phy-supply = <&vdd_logic>;
	ahci-supply = <&vdd5v0>;
	target-supply = <&vcc12v_dcin>;
    status = "okay";
};

&sdmmc0 {
    max-frequency = <150000000>;
    supports-sd;
    bus-width = <4>;
    cap-mmc-highspeed;
    cap-sd-highspeed;
    disable-wp;
    sd-uhs-sdr104;
    vmmc-supply = <&vcc3v3_sd>;
    vqmmc-supply = <&vccio_sd>;
    pinctrl-names = "default";
    pinctrl-0 = <&sdmmc0_bus4 &sdmmc0_clk &sdmmc0_cmd &sdmmc0_det>;
    status = "okay";
};

&sdmmc2 {
    max-frequency = <150000000>;
    supports-sdio;
    bus-width = <4>;
    disable-wp;
    cap-sd-highspeed;
    cap-sdio-irq;
    keep-power-in-suspend;
    non-removable;
	sd-uhs-sdr104;
	vmmc-supply = <&vcc3v3_sd>;
    vqmmc-supply = <&vccio_sd>;
    pinctrl-names = "default";
    pinctrl-0 = <&sdmmc2m0_bus4 &sdmmc2m0_cmd &sdmmc2m0_clk>;
    status = "okay";
};

&uart0 {
    status = "okay";
};

&uart3 {
    status = "okay";
    pinctrl-names = "default";
    pinctrl-0 = <&uart3m1_xfer>;
};

&uart4 {
    status = "okay";
    pinctrl-names = "default";
    pinctrl-0 = <&uart4m1_xfer>;
};

&uart7 {
    status = "okay";
    pinctrl-names = "default";
    pinctrl-0 = <&uart7m1_xfer>;
};

&uart8 {
    status = "okay";
	dma-names = "tx", "rx";
    pinctrl-names = "default";
    pinctrl-0 = <&uart8m0_xfer &uart8m0_ctsn>;
};

&uart9 {
    status = "okay";
    pinctrl-names = "default";
    pinctrl-0 = <&uart9m1_xfer>;
};

&u2phy0_host {
	dr_mode = "host";
	phy-supply = <&vcc5v0_host>;
    status = "okay";
};

&u2phy0_otg {
	dr_mode = "host";
	vbus-supply = <&vcc5v0_otg>;
    status = "okay";
};

&u2phy1_host {
	dr_mode = "host";
	phy-supply = <&vcc5v0_host>;
	status = "okay";

	gl850g: hub@1 {
        compatible = "usb5e3,610";
        reg = <1>;
        reset-gpios = <&gpio2 RK_PD7 GPIO_ACTIVE_LOW>;
		pinctrl-names = "default";
        pinctrl-0 = <&hub_rst_pin>;

        usb0: port@1 {
            reg = <1>; 
            #address-cells = <1>;
            #size-cells = <0>;
		};

		usb1: port@2 {
            reg = <2>;
            #address-cells = <1>;
            #size-cells = <0>;
		};

		usb2: port@3 {
            reg = <3>;
            #address-cells = <1>;
            #size-cells = <0>;
		};

		usb3: port@4 {
            reg = <4>;
            #address-cells = <1>;
            #size-cells = <0>;
		};
	};
};

&u2phy1_otg {
	dr_mode = "host";
	vbus-supply = <&vcc5v0_otg>;
    status = "okay";
};

&usb2phy0 {
    status = "okay";
};

&usb2phy1 {
    status = "okay";
};

&usb_host0_ehci {
    status = "okay";
};

&usb_host0_ohci {
    status = "okay";
};

&usb_host1_ehci {
    status = "okay";
};

&usb_host1_ohci {
    status = "okay";
};

&usbdrd_dwc3 {
    dr_mode = "host";
    extcon = <&usb2phy0>;
    status = "okay";
};

&usbdrd30 {
    status = "okay";
};

&usbhost_dwc3 {
    status = "okay";
};

&usbhost30 {
    status = "okay";
};

&vcc3v3_sys {
	vin-supply = <&vcc12v_dcin>;
};

&video_phy0 {
	status = "okay";
};

&vp0 {
	cursor-win-id = <ROCKCHIP_VOP2_ESMART0>;
	rockchip,plane-mask = <(1 << ROCKCHIP_VOP2_CLUSTER0)>;
	rockchip,primary-plane = <ROCKCHIP_VOP2_CLUSTER0>;
};

&vp1 {
	cursor-win-id = <ROCKCHIP_VOP2_ESMART1>;
	rockchip,plane-mask = <(1 << ROCKCHIP_VOP2_CLUSTER1)>;
	rockchip,primary-plane = <ROCKCHIP_VOP2_CLUSTER1>;
};

&vp2 {
	status = "disabled";
};
