                    13 00 02 C5 F5
                    13 00 02 C6 FA

                    13 00 02 C7 FC
                    13 00 02 C8 FC
                    13 00 02 C9 00
                    13 00 02 CA 01
                    13 00 02 CB 5A
                    13 00 02 CC BF
                    13 00 02 CD FF
                    13 00 02 CE FF
                    13 00 02 B0 0C
                    13 00 02 B1 00
                    13 00 02 B2 19
                    13 00 02 B3 31
                    13 00 02 B4 5A
                    13 00 02 B5 7C
                    13 00 02 B6 9C
                    13 00 02 B7 D3
                    13 00 02 B8 0E
                    13 00 02 B9 7D
                    13 00 02 BA E0
                    13 00 02 BB 7A
                    13 00 02 BC E6
                    13 00 02 BD E9
                    13 00 02 BE 41
                    13 00 02 BF 91
                    13 00 02 C0 B0
                    13 00 02 C1 CF
                    13 00 02 C2 DC
                    13 00 02 C3 E9
                    13 00 02 C4 EF
                    13 00 02 C5 F5
                    13 00 02 C6 FA
                    13 00 02 C7 FC
                    13 00 02 C8 FC
                    13 00 02 C9 00
                    13 00 02 CA 01
                    13 00 02 CB 5A
                    13 00 02 CC BF
                    13 00 02 CD FF
                    13 0A 02 CE FF

                    05 64 01 11
                    05 32 01 29
                ];
                panel-exit-sequence = [
                    05 00 01 28
                    05 00 01 10
                ];
                display-timings {
                    native-mode = <&dsi0_timing0>;
                    dsi0_timing0: timing0 {
                        clock-frequency = <156800000>;
                        hactive = <1200>;
                        vactive = <1920>;
                        hfront-porch = <110>;
                        hsync-len = <1>;
                        hback-porch = <32>;
                        vfront-porch = <11>;
                        vsync-len = <1>;
                        vback-porch = <14>;
                        hsync-active = <0>;
                        vsync-active = <0>;
                        de-active = <0>;
                        pixelclk-active = <1>;
                    };
                };
                ports {
                    #address-cells = <1>;
                    #size-cells = <0>;
                    port@0 {
                        reg = <0>;
                        panel_in_dsi0: endpoint {
                            remote-endpoint = <&dsi0_out_panel>;
                        };
                    };
                };
            };

            ports {
                #address-cells = <1>;
                #size-cells = <0>;

                dsi0_out: port@1 {
                    reg = <1>;
                    dsi0_out_panel: endpoint {
                        remote-endpoint = <&panel_in_dsi0>;
                    };
                };
            };
        };
    };

    fragment@2 {
        target = <&dsi0_in_vp3>;

        __overlay__ {
            status = "okay";
        };
    };

    fragment@3 {
        target = <&dsi_pwm>;

        __overlay__ {
            status = "okay";
        };
    };

    fragment@4 {
        target = <&route_dsi0>;

        __overlay__ {
            status = "okay";
            connect = <&vp3_out_dsi0>;
        };
    };

    fragment@5 {
        target = <&dsi_i2c>;

        __overlay__ {
            status = "okay";
            clock-frequency = <400000>;
            #address-cells = <1>;
            #size-cells = <0>;

            dsi0_gt911: dsi0-gt911@5d {
                compatible = "goodix,gt911";
                reg = <0x5d>;
                AVDD28-supply = <&vcc_3v3_s0>;
                VDDIO-supply = <&vcc_3v3_s0>;
                pinctrl-names = "default";
                pinctrl-0 = <&touch_gpio>;
                interrupts = <RK_PC3 IRQ_TYPE_EDGE_FALLING>;
                interrupt-parent = <&gpio3>;
                irq-gpios = <&gpio3 RK_PC3 GPIO_ACTIVE_HIGH>;
                reset-gpios = <&gpio3 RK_PB7 GPIO_ACTIVE_HIGH>;
                touchscreen-size-x = <1200>;
                touchscreen-size-y = <1920>;
                // touchscreen-inverted-x;
                // touchscreen-inverted-y;
                // touchscreen-swapped-x-y;
            };

            dsi0_pca9554: dsi0-pca9554@20 {
                compatible = "nxp,pca9554";
                reg = <0x20>;
                vcc-supply = <&vcc_3v3_s0>;
                pinctrl-names = "default";
                pinctrl-0 = <&keypad_gpio>;
                interrupt-parent = <&gpio3>;
                interrupts = <RK_PA0 IRQ_TYPE_EDGE_FALLING>;
                gpio-controller;
                #gpio-cells = <2>;
                interrupt-controller;
                #interrupt-cells = <2>;
            };
        };
    };
};