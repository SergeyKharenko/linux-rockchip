                    15 00 02 8E 40 
                    15 00 02 91 11 
                    15 00 02 92 2C 
                    15 00 02 93 2D 
                    15 00 02 94 03 
                    15 00 02 A0 0A 
                    15 00 02 A2 13 
                    15 00 02 FF 00 
        
                    05 96 01 11
                    05 14 01 29
                ];
        
                panel-exit-sequence = [
                    05 78 01 28
                    05 78 01 10
                ];
        
                display-timings {
                    native-mode = <&dsi0_timing0>;
                    dsi0_timing0: timing0 {
                        clock-frequency = <148000000>;
                        hactive = <1200>;
                        vactive = <1920>;
                        hfront-porch = <36>;
                        hsync-len = <10>;
                        hback-porch = <36>;
                        vfront-porch = <8>;
                        vsync-len = <2>;
                        vback-porch = <7>;
                        hsync-active = <0>;
                        vsync-active = <0>;
                        de-active = <0>;
                        pixelclk-active = <0>;
                    };
                };
        
                ports {
                    #address-cells = <1>;
                    #size-cells = <0>;
                    port@0 {
                        reg = <0>;
                        panel_in_dsi0: endpoint {
                            remote-endpoint = <&dsi0_out_panel>;
                        };
                    };
                };
            };
        
            ports {
                #address-cells = <1>;
                #size-cells = <0>;
        
                dsi0_out: port@1 {
                    reg = <1>;
                    dsi0_out_panel: endpoint {
                        remote-endpoint = <&panel_in_dsi0>;
                    };
                };
            };
        };
    };

    fragment@2 {
        target = <&dsi0_in_vp1>;

        __overlay__ {
            status = "okay";
        };
    };

    fragment@3 {
        target = <&dsi0_pwm>;

        __overlay__ {
            status = "okay";
        };
    };

    fragment@4 {
        target = <&route_dsi0>;

        __overlay__ {
            status = "okay";
            connect = <&vp1_out_dsi0>;
        };
    };

    fragment@5 {
        target = <&video_phy0>;

        __overlay__ {
            status = "okay";
        };
    };
    
    fragment@6 {
        target = <&dsi_i2c>;

        __overlay__ {
            status = "okay";
            clock-frequency = <400000>;
            #address-cells = <1>;
            #size-cells = <0>;

            dsi0_gt911: dsi0-gt911@14 {
                compatible = "goodix,gt911";
                reg = <0x14>;
                AVDD28-supply = <&vdd3v3>;
                VDDIO-supply = <&vdd3v3>;
                pinctrl-names = "default";
                pinctrl-0 = <&touch_gpio>;
                interrupts = <RK_PA2 IRQ_TYPE_EDGE_FALLING>;
                interrupt-parent = <&gpio3>;
                irq-gpios = <&gpio3 RK_PA2 GPIO_ACTIVE_HIGH>;
                reset-gpios = <&gpio3 RK_PA0 GPIO_ACTIVE_HIGH>;
                touchscreen-size-x = <1200>;
                touchscreen-size-y = <1920>;
            };
        };
    };
};
