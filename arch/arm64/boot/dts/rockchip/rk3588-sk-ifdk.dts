			13 00 02 BF 91
			13 00 02 C0 B0
			13 00 02 C1 CF
			13 00 02 C2 DC
			13 00 02 C3 E9
			13 00 02 C4 EF
			13 00 02 C5 F5
			13 00 02 C6 FA
			13 00 02 C7 FC
			13 00 02 C8 FC
			13 00 02 C9 00
			13 00 02 CA 01
			13 00 02 CB 5A
			13 00 02 CC BF
			13 00 02 CD FF
			13 0A 02 CE FF

            05 64 01 11
            05 32 01 29
        ];
        panel-exit-sequence = [
            05 00 01 28
            05 00 01 10
        ];
        display-timings {
            native-mode = <&dsi0_timing0>;
            dsi0_timing0: timing0 {
                clock-frequency = <156800000>;
                hactive = <1200>;
                vactive = <1920>;
                hfront-porch = <110>;
                hsync-len = <1>;
                hback-porch = <32>;
                vfront-porch = <11>;
                vsync-len = <1>;
                vback-porch = <14>;
                hsync-active = <0>;
                vsync-active = <0>;
                de-active = <0>;
                pixelclk-active = <1>;
            };
        };
        ports {
            #address-cells = <1>;
            #size-cells = <0>;
            port@0 {
                reg = <0>;
                panel_in_dsi0: endpoint {
                    remote-endpoint = <&dsi0_out_panel>;
                };
            };
        };
    };

    ports {
		#address-cells = <1>;
		#size-cells = <0>;

		dsi0_out: port@1 {
			reg = <1>;
			dsi0_out_panel: endpoint {
				remote-endpoint = <&panel_in_dsi0>;
			};
		};
	};
};

&dsi0_in_vp2 {
	status = "disabled";
};

&dsi0_in_vp3 {
	status = "okay";
};

&dsi1 {
	status = "disabled";
};

&gmac0 {
	status = "okay";
	/* Use rgmii-rxid mode to disable rx delay inside Soc */
	phy-mode = "rgmii-rxid";
	phy-supply = <&vcc3v3_phy0>;
	clock_in_out = "output";
	
	snps,reset-gpio = <&gpio4 RK_PB3 GPIO_ACTIVE_LOW>;
	snps,reset-active-low;
	/* Reset time is 20ms, 100ms for rtl8211f */
	snps,reset-delays-us = <0 20000 100000>;
	
	pinctrl-names = "default";
	pinctrl-0 = <&gmac0_miim
		&gmac0_tx_bus2
		&gmac0_rx_bus2
		&gmac0_rgmii_clk
		&gmac0_rgmii_bus>;
	
	tx_delay = <0x43>;
	
	phy-handle = <&rgmii_phy>;
};

&hdmi0 {
	status = "okay";
	cec-enable = "true";
	enable-gpios = <&gpio4 RK_PB1 GPIO_ACTIVE_HIGH>;
};

&hdmi0_in_vp0 {
	status = "okay";
};

&hdmi0_in_vp1 {
	status = "disabled";
};

&hdmi0_in_vp2 {
	status = "disabled";
};

&hdmi1 {
	status = "okay";
	cec-enable = "true";
	enable-gpios = <&gpio4 RK_PB2 GPIO_ACTIVE_HIGH>;
};

&hdmi1_in_vp0 {
	status = "okay";
};

&hdmi1_in_vp1 {
	status = "disabled";
};

&hdmi1_in_vp2 {
	status = "disabled";
};

/* Should work with at least 128MB cma reserved above. */
&hdmirx_ctrler {
	status = "okay";
	#sound-dai-cells = <1>;
	edid-version = <3>;
	/* Effective level used to trigger HPD: 0-low, 1-high */
	hpd-trigger-level = <1>;
	hdmirx-det-gpios = <&gpio2 RK_PB5 GPIO_ACTIVE_LOW>;
	pinctrl-names = "default";
	pinctrl-0 = <&hdmim1_rx &hdmirx_det>;
};

&hdptxphy_hdmi0 {
	status = "okay";
};

&hdptxphy_hdmi1 {
	status = "okay";
};

dsi_i2c: &i2c5 {
	/* connect to dsi touch */
	status = "okay";
	clock-frequency = <400000>;
	#address-cells = <1>;
	#size-cells = <0>;

	dsi0_gt911: dsi0-gt911@5d {
        compatible = "goodix,gt911";
        reg = <0x5d>;
        AVDD28-supply = <&vcc_3v3_s0>;
        VDDIO-supply = <&vcc_3v3_s0>;
        pinctrl-names = "default";
        pinctrl-0 = <&touch_gpio>;
        interrupts = <RK_PC3 IRQ_TYPE_EDGE_FALLING>;
        interrupt-parent = <&gpio3>;
        irq-gpios = <&gpio3 RK_PC3 GPIO_ACTIVE_HIGH>;
        reset-gpios = <&gpio3 RK_PB7 GPIO_ACTIVE_HIGH>;
        touchscreen-size-x = <1200>;
        touchscreen-size-y = <1920>;
        // touchscreen-inverted-x;
        // touchscreen-inverted-y;
        // touchscreen-swapped-x-y;
    };

	dsi0_pca9554: dsi0-pca9554@20 {
		compatible = "nxp,pca9554";
		reg = <0x20>;
		vcc-supply = <&vcc_3v3_s0>;
		pinctrl-names = "default";
		pinctrl-0 = <&keypad_gpio>;
		interrupt-parent = <&gpio3>;
		interrupts = <RK_PA0 IRQ_TYPE_EDGE_FALLING>;
		gpio-controller;
		#gpio-cells = <2>;
		interrupt-controller;
        #interrupt-cells = <2>;
	};
};

&i2c6 {
	hym8563: hym8563@51 {
		compatible = "haoyu,hym8563";
		reg = <0x51>;
		#clock-cells = <0>;
		clock-frequency = <32768>;
		clock-output-names = "hym8563";
		pinctrl-names = "default";
		pinctrl-0 = <&hym8563_int>;
		interrupt-parent = <&gpio0>;
		interrupts = <RK_PB0 IRQ_TYPE_LEVEL_LOW>;
		wakeup-source;
	};
};

&i2c7 {
	status = "okay";
	
	es8388: es8388@11 {
		status = "okay";
		#sound-dai-cells = <0>;
		compatible = "everest,es8388", "everest,es8323";
		reg = <0x11>;
		clocks = <&cru I2S0_8CH_MCLKOUT>;
		clock-names = "mclk";
		assigned-clocks = <&cru I2S0_8CH_MCLKOUT>;
		assigned-clock-rates = <12288000>;
		pinctrl-names = "default";
		pinctrl-0 = <&i2s0_mclk>;
	};
};

&i2s0_8ch {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&i2s0_sdi0
	&i2s0_sdo0
	&i2s0_lrck
	&i2s0_sclk>;
};

&i2s5_8ch {
	status = "okay";
};

&i2s6_8ch {
	status = "okay";
};

&i2s7_8ch {
	status = "okay";
};

&mdio0 {
	rgmii_phy: phy@1 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <0x1>;
	};
};

&pcie2x1l0 {
	status = "okay";
	supports-clkreq;
	rockchip,skip-scan-in-resume;
	rockchip,perst-inactive-ms = <40>;
	vpcie3v3-supply = <&vcc_3v3_s3>;
	pinctrl-names = "default";
	pinctrl-0 = <&pcie2x1l0_pins>;
	reset-gpios = <&gpio1 RK_PB4 GPIO_ACTIVE_HIGH>;
};

&pcie2x1l1 {
	status = "okay";
	supports-clkreq;
	rockchip,skip-scan-in-resume;
	rockchip,perst-inactive-ms = <100>;
	vpcie3v3-supply = <&vcc3v3_phy1>;
	pinctrl-names = "default";
	pinctrl-0 = <&pcie2x1l1_pins>;
	reset-gpios = <&gpio4 RK_PA2 GPIO_ACTIVE_HIGH>;
	
	pcie@0,0 {
		reg = <0x00200000 0 0 0 0>;
		#address-cells = <3>;
		#size-cells = <2>;
		
		r8111_u10: pcie@20,0 {
			reg = <0x000000 0 0 0 0>;
		};
	};
};

&pcie30phy{
	status = "okay";
	rockchip,pcie30-phymode = <PHY_MODE_PCIE_NANBNB>;
};

&pcie3x2{
	status = "okay";
	supports-clkreq;
	pinctrl-names = "default";
	pinctrl-0 = <&pcie30x2m3_pins>;
	reset-gpios = <&gpio1 RK_PB7 GPIO_ACTIVE_HIGH>;
	vpcie3v3-supply = <&vcc3v3_pcie30>;
};

&pcie3x4{
	status = "okay";
	supports-clkreq;
	num-lanes = <2>;
	pinctrl-names = "default";
	pinctrl-0 = <&pcie30x4m1_pins>;
	reset-gpios = <&gpio4 RK_PB6 GPIO_ACTIVE_HIGH>;
	vpcie3v3-supply = <&vcc3v3_pcie30>;
};

&pinctrl {
	gpio-fans {
		/omit-if-no-ref/
		sys_fan_pin: sys-fan-pin {
			rockchip,pins = <4 RK_PA5 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
	
	gpio-leds {
		sys_led_pin: sys-led-pin {
			rockchip,pins = <4 RK_PB0 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		key_led_pin: key-led-pin {
			rockchip,pins = <3 RK_PB3 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
	
	rtc {
		hym8563_int: hym8563-int {
			rockchip,pins = <0 RK_PB0 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};
	
	hdmi {
		hdmirx_det: hdmirx-det {
			rockchip,pins = <2 RK_PB5 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};
	
	headphone {
		hp_det: hp-det {
			rockchip,pins = <1 RK_PD5 RK_FUNC_GPIO &pcfg_pull_down>;
		};
		
		hp_ctl: hp-ctl {
			rockchip,pins = <1 RK_PD2 RK_FUNC_GPIO &pcfg_pull_down>;
		};
		
		spk_ctl: spk-ctl {
			rockchip,pins = <1 RK_PD3 RK_FUNC_GPIO &pcfg_pull_down>;
		};
	};
	
	lcd {
		lcd_rst_gpio: lcd-rst-gpio {
			rockchip,pins = <1 RK_PC4 RK_FUNC_GPIO &pcfg_pull_down>;
		};
	};

	key {
		keypad_gpio: keypad-gpio {
			rockchip,pins = <3 RK_PA0 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};
	
	pcie {
		pcie30_pwren: pcie30-pwren {
			rockchip,pins = <2 RK_PB4 RK_FUNC_GPIO &pcfg_pull_up>;
		};
		
		pcie2x1l0_pins: pcie2x1l0-pins {
			rockchip,pins = 
			/* pcie30x1_0_clkreqn_m2 */
			<1 RK_PB5 4 &pcfg_pull_none>,
			/* pcie30x1_0_perstn_m2 */
			<1 RK_PB4 4 &pcfg_pull_none>,
			/* pcie30x1_0_waken_m2 */
			<1 RK_PB3 4 &pcfg_pull_none>;
		};
		
		pcie2x1l1_pins: pcie2x1l1-pins {
			rockchip,pins = 
			/* pcie30x1_1_clkreqn_m1 */
			<4 RK_PA0 4 &pcfg_pull_none>,
			/* pcie30x1_1_perstn_m1 */
			<4 RK_PA2 4 &pcfg_pull_none>,
			/* pcie30x1_1_waken_m1 */
			<4 RK_PA1 4 &pcfg_pull_none>;
		};
	};
	
	touch {
		/omit-if-no-ref/
		touch_gpio: touch-gpio {
			rockchip,pins = 
			<3 RK_PB7 RK_FUNC_GPIO &pcfg_pull_none>,
			<3 RK_PC3 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
	
	usb {
		usbc0_int: usbc0-int {
			rockchip,pins = <0 RK_PD3 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};
	
	vga {
		vga_hpd: vga-hpd {
			rockchip,pins = <3 RK_PA1 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};
	
	wireless-bluetooth {
		uart8_gpios: uart8-gpios {
			rockchip,pins = <3 RK_PA4 RK_FUNC_GPIO &pcfg_pull_none>;
		};
		
		bt_gpio: bt-gpio {
			rockchip,pins =
			<0 RK_PC6 RK_FUNC_GPIO &pcfg_pull_none>,
			<0 RK_PC5 RK_FUNC_GPIO &pcfg_pull_none>,
			<0 RK_PA0 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
	
	wireless-wlan {
		wifi_host_wake_irq: wifi-host-wake-irq {
			rockchip,pins = <0 RK_PB2 RK_FUNC_GPIO &pcfg_pull_down>;
		};
		
		wifi_poweren_gpio: wifi-poweren-gpio {
			rockchip,pins = <0 RK_PC4 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};
};

