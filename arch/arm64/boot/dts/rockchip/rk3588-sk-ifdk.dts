/dts-v1/;
#include <dt-bindings/input/input.h>
#include <dt-bindings/phy/phy-snps-pcie3.h>
#include "rk3588-sk-ifdk-core.dtsi"

/ {
	model = "SK IFDK Board";
	compatible = "sk,ifdk", "rockchip,rk3588";
	
	aliases {
		ethernet0 = &r8111_u10;
		ethernet1 = &gmac0;
		mmc0 = &sdhci;
		mmc1 = &sdmmc;
		vga0 = &vga0;
		dp0 = &dp0;
	};
	
	/* If hdmirx node is disabled, delete the reserved-memory node here. */
	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
		
		/* Reserve 256MB memory for hdmirx-controller@fdee0000 */
		cma {
			compatible = "shared-dma-pool";
			reusable;
			reg = <0x0 (256 * 0x100000) 0x0 (256 * 0x100000)>;
			linux,cma-default;
		};
	};

	adc_keys: adc-keys {
		compatible = "adc-keys";
		io-channels = <&saradc 0>;
		io-channel-names = "buttons";
		keyup-threshold-microvolt = <1800000>;
		poll-interval = <100>;

		key-rst {
			label = "reset";
			linux,code = <KEY_RESTART>;
			press-threshold-microvolt = <1750>;
		};
	};
	
	es8388_sound: es8388-sound {
		compatible = "rockchip,multicodecs-card";
		rockchip,card-name = "rockchip-es8388";
		io-channels = <&saradc 3>;
		io-channel-names = "adc-detect";
		keyup-threshold-microvolt = <1800000>;
		poll-interval = <100>;
		
		pinctrl-names = "default";
		pinctrl-0 = <&hp_det &hp_ctl &spk_ctl>;
		
		spk-con-gpio = <&gpio1 RK_PD3 GPIO_ACTIVE_HIGH>;
		hp-con-gpio = <&gpio1 RK_PD2 GPIO_ACTIVE_HIGH>;
		hp-det-gpio = <&gpio1 RK_PD5 GPIO_ACTIVE_LOW>;
		
		rockchip,format = "i2s";
		rockchip,mclk-fs = <256>;
		rockchip,cpu = <&i2s0_8ch>;
		rockchip,codec = <&es8388>;
		rockchip,audio-routing =
		"Headphone", "LOUT1",
		"Headphone", "ROUT1",
		
		"Speaker", "LOUT2",
		"Speaker", "ROUT2",
		"Headphone", "Headphone Power",
		"Headphone", "Headphone Power",
		"Speaker", "Speaker Power",
		"Speaker", "Speaker Power",
		"LINPUT1", "Main Mic",
		"LINPUT2", "Main Mic",
		"RINPUT1", "Headset Mic",
		"RINPUT2", "Headset Mic";
		
		play-pause-key {
			label = "playpause";
			linux,code = <KEY_PLAYPAUSE>;
			press-threshold-microvolt = <2000>;
		};
	};
	
	gpio_leds: gpio-leds {
		compatible = "gpio-leds";
		sys_led: sys-led {
			gpios = <&gpio4 RK_PB0 GPIO_ACTIVE_HIGH>;
			label = "sys_led";
			linux,default-trigger = "heartbeat";
			pinctrl-names = "default";
			pinctrl-0 = <&sys_led_pin>;
		};
	};
	
	hdmi0_sound: hdmi0-sound {
		compatible = "rockchip,hdmi";
		rockchip,mclk-fs = <128>;
		rockchip,card-name = "rockchip-hdmi0";
		rockchip,cpu = <&i2s5_8ch>;
		rockchip,codec = <&hdmi0>;
	};
	
	hdmi1_sound: hdmi1-sound {
		compatible = "rockchip,hdmi";
		rockchip,mclk-fs = <128>;
		rockchip,card-name = "rockchip-hdmi1";
		rockchip,cpu = <&i2s6_8ch>;
		rockchip,codec = <&hdmi1>;
	};
	
	hdmiin_sound: hdmiin-sound {
		compatible = "rockchip,hdmi";
		rockchip,mclk-fs = <128>;
		rockchip,format = "i2s";
		rockchip,bitclock-master = <&hdmirx_ctrler>;
		rockchip,frame-master = <&hdmirx_ctrler>;
		rockchip,card-name = "rockchip-hdmiin";
		rockchip,cpu = <&i2s7_8ch>;
		rockchip,codec = <&hdmirx_ctrler 0>;
		rockchip,jack-det;
	};
	
	vcc12v_dcin: vcc12v-dcin-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vcc12v_dcin";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <12000000>;
		regulator-max-microvolt = <12000000>;
	};

	vcc12v_lcd: vcc12v-lcd-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vcc12v_lcd";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <12000000>;
		regulator-max-microvolt = <12000000>;
		vin-supply = <&vcc12v_dcin>;
	};
	
	vcc12v_sata: vcc12v-sata-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vcc12v_sata";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <12000000>;
		regulator-max-microvolt = <12000000>;
		vin-supply = <&vcc12v_dcin>;
	};
	
	vcc5v0_sata: vcc5v0-sata-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_sata";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		vin-supply = <&vcc5v0_sys>;
	};
	
	vcc5v0_host_30: vcc5v0-host-30 {
		compatible = "regulator-fixed";
		regulator-always-on;
		regulator-boot-on;
		regulator-name = "vcc5v0_host_30";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		vin-supply = <&vcc5v0_usb>;
	};
	
	vcc5v0_host_20: vcc5v0-host-20 {
		compatible = "regulator-fixed";
		regulator-always-on;
		regulator-boot-on;
		regulator-name = "vcc5v0_host_20";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		vin-supply = <&vcc5v0_usb>;
	};
	
	vcc5v0_usb: vcc5v0-usb-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_usb";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		vin-supply = <&vcc12v_dcin>;
	};
	
	vcc3v3_pcie30: vcc3v3-pcie30-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3_pcie30";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		enable-active-high;
		pinctrl-names = "default";
		pinctrl-0 = <&pcie30_pwren>;
		gpios = <&gpio2 RK_PB4 GPIO_ACTIVE_HIGH>;
		startup-delay-us = <5000>;
		vin-supply = <&vcc12v_dcin>;
	};
	
	vcc3v3_phy0: vcc3v3-phy0-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3_phy0";
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&vcc_3v3_s0>;
	};
	
	vcc3v3_phy1: vcc3v3-phy1-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3_phy1";
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&vcc_3v3_s0>;
	};
	
	vcc_3v3_sd_s0: vcc-3v3-sd-s0-regulator {
		compatible = "regulator-fixed";
		regulator-always-on;
		regulator-boot-on;
		regulator-max-microvolt = <3000000>;
		regulator-min-microvolt = <3000000>;
		regulator-name = "vcc_3v3_sd_s0";
		vin-supply = <&vcc_3v3_s3>;
	};
	
	wireless_bluetooth: wireless-bluetooth {
		compatible = "bluetooth-platdata";
		clocks = <&hym8563>;
		clock-names = "ext_clock";
		uart_rts_gpios = <&gpio3 RK_PA4 GPIO_ACTIVE_LOW>;
		pinctrl-names = "default", "rts_gpio";
		pinctrl-0 = <&uart8m1_rtsn>, <&bt_gpio>;
		pinctrl-1 = <&uart8_gpios>;
		BT,reset_gpio    = <&gpio0 RK_PC6 GPIO_ACTIVE_HIGH>;
		BT,wake_gpio     = <&gpio0 RK_PC5 GPIO_ACTIVE_HIGH>;
		BT,wake_host_irq = <&gpio0 RK_PA0 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};
	
	wireless_wlan: wireless-wlan {
		compatible = "wlan-platdata";
		clocks = <&hym8563>;
		clock-names = "ext_clock";
		wifi_chip_type = "ap6275p";
		pinctrl-names = "default";
		pinctrl-0 = <&wifi_host_wake_irq>, <&wifi_poweren_gpio>;
		WIFI,host_wake_irq = <&gpio0 RK_PB2 GPIO_ACTIVE_HIGH>;
		WIFI,poweren_gpio = <&gpio0 RK_PC4 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};
};

&can0 {
	status = "okay";
};

&combphy0_ps {
	status = "okay";
};

&combphy1_ps {
	status = "okay";
};

&combphy2_psu {
	status = "okay";
};

vga0: &dp1 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&vga_hpd>;
	hpd-gpios = <&gpio3 RK_PA1 GPIO_ACTIVE_HIGH>;
};

&dp1_in_vp0 {
	status = "disabled";
};

&dp1_in_vp1 {
	status = "disabled";
};

&dp1_in_vp2 {
	status = "okay";
};

&display_subsystem {
	clocks = <&hdptxphy_hdmi0>, <&hdptxphy_hdmi1>;
	clock-names = "hdmi0_phy_pll", "hdmi1_phy_pll";
};

&dsi0 {
	status = "disabled";
};

&dsi0_in_vp2 {
	status = "disabled";
};

&dsi0_in_vp3 {
	status = "disabled";
};

&dsi1 {
	status = "disabled";
};

&gmac0 {
	status = "okay";
	/* Use rgmii-rxid mode to disable rx delay inside Soc */
	phy-mode = "rgmii-rxid";
	phy-supply = <&vcc3v3_phy0>;
	clock_in_out = "output";
	
	snps,reset-gpio = <&gpio4 RK_PB3 GPIO_ACTIVE_LOW>;
	snps,reset-active-low;
	/* Reset time is 20ms, 100ms for rtl8211f */
	snps,reset-delays-us = <0 20000 100000>;
	
	pinctrl-names = "default";
	pinctrl-0 = <&gmac0_miim
		&gmac0_tx_bus2
		&gmac0_rx_bus2
		&gmac0_rgmii_clk
		&gmac0_rgmii_bus>;
	
	tx_delay = <0x43>;
	
	phy-handle = <&rgmii_phy>;
};

&hdmi0 {
	status = "okay";
	cec-enable = "true";
	enable-gpios = <&gpio4 RK_PB1 GPIO_ACTIVE_HIGH>;
};

&hdmi0_in_vp0 {
	status = "okay";
};

&hdmi0_in_vp1 {
	status = "disabled";
};

&hdmi0_in_vp2 {
	status = "disabled";
};

&hdmi1 {
	status = "okay";
	cec-enable = "true";
	enable-gpios = <&gpio4 RK_PB2 GPIO_ACTIVE_HIGH>;
};

&hdmi1_in_vp0 {
	status = "okay";
};

&hdmi1_in_vp1 {
	status = "disabled";
};

&hdmi1_in_vp2 {
	status = "disabled";
};

/* Should work with at least 128MB cma reserved above. */
&hdmirx_ctrler {
	status = "okay";
	#sound-dai-cells = <1>;
	edid-version = <3>;
	/* Effective level used to trigger HPD: 0-low, 1-high */
	hpd-trigger-level = <1>;
	hdmirx-det-gpios = <&gpio2 RK_PB5 GPIO_ACTIVE_LOW>;
	pinctrl-names = "default";
	pinctrl-0 = <&hdmim1_rx &hdmirx_det>;
};

&hdptxphy_hdmi0 {
	status = "okay";
};

&hdptxphy_hdmi1 {
	status = "okay";
};

dsi_i2c: &i2c5 {
	/* connect to dsi touch */
	status = "disabled";
};

&i2c6 {
	hym8563: hym8563@51 {
		compatible = "haoyu,hym8563";
		reg = <0x51>;
		#clock-cells = <0>;
		clock-frequency = <32768>;
		clock-output-names = "hym8563";
		pinctrl-names = "default";
		pinctrl-0 = <&hym8563_int>;
		interrupt-parent = <&gpio0>;
		interrupts = <RK_PB0 IRQ_TYPE_LEVEL_LOW>;
		wakeup-source;
	};
};

&i2c7 {
	status = "okay";
	
	es8388: es8388@11 {
		status = "okay";
		#sound-dai-cells = <0>;
		compatible = "everest,es8388", "everest,es8323";
		reg = <0x11>;
		clocks = <&cru I2S0_8CH_MCLKOUT>;
		clock-names = "mclk";
		assigned-clocks = <&cru I2S0_8CH_MCLKOUT>;
		assigned-clock-rates = <12288000>;
		pinctrl-names = "default";
		pinctrl-0 = <&i2s0_mclk>;
	};
};

&i2s0_8ch {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&i2s0_sdi0
	&i2s0_sdo0
	&i2s0_lrck
	&i2s0_sclk>;
};

&i2s5_8ch {
	status = "okay";
};

&i2s6_8ch {
	status = "okay";
};

&i2s7_8ch {
	status = "okay";
};

&mdio0 {
	rgmii_phy: phy@1 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <0x1>;
	};
};

&pcie2x1l0 {
	status = "okay";
	supports-clkreq;
	rockchip,skip-scan-in-resume;
	rockchip,perst-inactive-ms = <40>;
	vpcie3v3-supply = <&vcc_3v3_s3>;
	pinctrl-names = "default";
	pinctrl-0 = <&pcie2x1l0_pins>;
	reset-gpios = <&gpio1 RK_PB4 GPIO_ACTIVE_HIGH>;
};

&pcie2x1l1 {
	status = "okay";
	supports-clkreq;
	rockchip,skip-scan-in-resume;
	rockchip,perst-inactive-ms = <100>;
	vpcie3v3-supply = <&vcc3v3_phy1>;
	pinctrl-names = "default";
	pinctrl-0 = <&pcie2x1l1_pins>;
	reset-gpios = <&gpio4 RK_PA2 GPIO_ACTIVE_HIGH>;
	
	pcie@0,0 {
		reg = <0x00200000 0 0 0 0>;
		#address-cells = <3>;
		#size-cells = <2>;
		
		r8111_u10: pcie@20,0 {
			reg = <0x000000 0 0 0 0>;
		};
	};
};

&pcie30phy{
	status = "okay";
	rockchip,pcie30-phymode = <PHY_MODE_PCIE_NANBNB>;
};

&pcie3x2{
	status = "okay";
	supports-clkreq;
	pinctrl-names = "default";
	pinctrl-0 = <&pcie30x2m3_pins>;
	reset-gpios = <&gpio1 RK_PB7 GPIO_ACTIVE_HIGH>;
	vpcie3v3-supply = <&vcc3v3_pcie30>;
};

&pcie3x4{
	status = "okay";
	supports-clkreq;
	num-lanes = <2>;
	pinctrl-names = "default";
	pinctrl-0 = <&pcie30x4m1_pins>;
	reset-gpios = <&gpio4 RK_PB6 GPIO_ACTIVE_HIGH>;
	vpcie3v3-supply = <&vcc3v3_pcie30>;
};

&pinctrl {
	gpio-fans {
		/omit-if-no-ref/
		sys_fan_pin: sys-fan-pin {
			rockchip,pins = <4 RK_PA5 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
	
	gpio-leds {
		sys_led_pin: sys-led-pin {
			rockchip,pins = <4 RK_PB0 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
	
	rtc {
		hym8563_int: hym8563-int {
			rockchip,pins = <0 RK_PB0 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};
	
	hdmi {
		hdmirx_det: hdmirx-det {
			rockchip,pins = <2 RK_PB5 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};
	
	headphone {
		hp_det: hp-det {
			rockchip,pins = <1 RK_PD5 RK_FUNC_GPIO &pcfg_pull_down>;
		};
		
		hp_ctl: hp-ctl {
			rockchip,pins = <1 RK_PD2 RK_FUNC_GPIO &pcfg_pull_down>;
		};
		
		spk_ctl: spk-ctl {
			rockchip,pins = <1 RK_PD3 RK_FUNC_GPIO &pcfg_pull_down>;
		};
	};
	
	lcd {
		lcd_rst_gpio: lcd-rst-gpio {
			rockchip,pins = <1 RK_PC4 RK_FUNC_GPIO &pcfg_pull_down>;
		};
	};

	key {
		keypad_gpio: keypad-gpio {
			rockchip,pins = <3 RK_PA0 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};
	
	pcie {
		pcie30_pwren: pcie30-pwren {
			rockchip,pins = <2 RK_PB4 RK_FUNC_GPIO &pcfg_pull_up>;
		};
		
		pcie2x1l0_pins: pcie2x1l0-pins {
			rockchip,pins = 
			/* pcie2x1l0_clkreqn */
			<1 RK_PB5 RK_FUNC_GPIO &pcfg_pull_up>,
			/* pcie2x1l0_perstn */
			<1 RK_PB4 RK_FUNC_GPIO &pcfg_pull_up>,
			/* pcie2x1l0_waken */
			<1 RK_PB3 RK_FUNC_GPIO &pcfg_pull_up>;
		};
		
		pcie2x1l1_pins: pcie2x1l1-pins {
			rockchip,pins = 
			/* pcie2x1l1_clkreqn */
			<4 RK_PA0 RK_FUNC_GPIO &pcfg_pull_up>,
			/* pcie2x1l1_perstn */
			<4 RK_PA2 RK_FUNC_GPIO &pcfg_pull_up>,
			/* pcie2x1l1_waken */
			<4 RK_PA1 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};
	
	touch {
		/omit-if-no-ref/
		touch_gpio: touch-gpio {
			rockchip,pins = 
			<3 RK_PB7 RK_FUNC_GPIO &pcfg_pull_none>,
			<3 RK_PC3 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
	
	usb {
		usbc0_int: usbc0-int {
			rockchip,pins = <0 RK_PD3 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};
	
	vga {
		vga_hpd: vga-hpd {
			rockchip,pins = <3 RK_PA1 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};
	
	wireless-bluetooth {
		uart8_gpios: uart8-gpios {
			rockchip,pins = <3 RK_PA4 RK_FUNC_GPIO &pcfg_pull_none>;
		};
		
		bt_gpio: bt-gpio {
			rockchip,pins =
			<0 RK_PC6 RK_FUNC_GPIO &pcfg_pull_none>,
			<0 RK_PC5 RK_FUNC_GPIO &pcfg_pull_none>,
			<0 RK_PA0 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
	
	wireless-wlan {
		wifi_host_wake_irq: wifi-host-wake-irq {
			rockchip,pins = <0 RK_PB2 RK_FUNC_GPIO &pcfg_pull_down>;
		};
		
		wifi_poweren_gpio: wifi-poweren-gpio {
			rockchip,pins = <0 RK_PC4 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};
};

ir_pwm: &pwm11 {
	/* connected with IR */
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&pwm11m3_pins>;
};

dsi_pwm: &pwm14 {
	/* connected with dsi0 and dsi1 */
	status = "disabled";
};

&route_hdmi0 {
	status = "okay";
};

&route_hdmi1 {
	status = "okay";
	connect = <&vp0_out_hdmi1>;
};

&route_dp1 {
	status = "okay";
	connect = <&vp2_out_dp1>;
};

&route_dsi0 {
	status = "disabled";
};

&sata0 {
	status = "okay";
	target-supply = <&vcc12v_sata>;
	ahci-supply = <&vcc5v0_sata>;
};

&sdmmc {
	status = "okay";
	max-frequency = <200000000>;
	bus-width = <4>;
	cap-mmc-highspeed;
	cap-sd-highspeed;
	disable-wp;
	sd-uhs-sdr104;
	vmmc-supply = <&vcc_3v3_sd_s0>;
	vqmmc-supply = <&vccio_sd_s0>;
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc_bus4 &sdmmc_clk &sdmmc_cmd &sdmmc_det>;
};

&u2phy1 {
	status = "okay";
};

&u2phy2 {
	status = "okay";
};

&u2phy3 {
	status = "okay";
};

&u2phy1_otg {
	status = "okay";
	phy-supply = <&vcc5v0_host_30>;
};

&u2phy2_host {
	status = "okay";
	phy-supply = <&vcc5v0_host_20>;
};

&u2phy3_host {
	status = "okay";
	phy-supply = <&vcc5v0_host_20>;
};

&uart0 {
	status = "okay";
	pinctrl-0 = <&uart0m2_xfer>;
};

&uart3 {
	status = "okay";
	pinctrl-0 = <&uart3m1_xfer>;
	linux,rs485-enabled-at-boot-time;
	rs485-rx-during-tx;
};

&uart7 {
	status = "okay";
};

&uart8 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&uart8m1_xfer &uart8m1_ctsn>;
};

&usbdp_phy1 {
	status = "okay";
	rockchip,dp-lane-mux = <2 3>;
};

&usbdp_phy1_dp {
	status = "okay";
};

&usbdp_phy1_u3 {
	status = "okay";
	phy-supply = <&vcc5v0_host_30>;
};

&usbdrd3_1 {
	status = "okay";
};

&usbdrd_dwc3_1 {
	status = "okay";
	snps,xhci-trb-ent-quirk;
	maximum-speed = "super-speed";
};

&usb_host0_ehci {
	status = "okay";
};

&usb_host0_ohci {
	status = "okay";
};

&usb_host1_ehci {
	status = "okay";
};

&usb_host1_ohci {
	status = "okay";
};

&vcc5v0_sys {
	vin-supply = <&vcc12v_dcin>;
};

&vcc5v0_typec {
	vin-supply = <&vcc12v_dcin>;
};
